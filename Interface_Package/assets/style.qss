/* --- Sfondo Globale --- */
QMainWindow, QDialog, QStackedWidget {
    background-color: #1e1e1e;
    color: #f0f0f0;
    font-family: "Segoe UI", "Roboto", "Helvetica Neue", sans-serif;
}

/* --- Label globali --- */
QLabel {
    color: #f0f0f0;
    font-size: 13px;
}

/* =========================================
   BOTTONI HERO (HOME VIEW)
   ========================================= */

QPushButton[class="HeroButton"] {
    background-color: #252526;
    color: #f0f0f0;
    border: 2px solid #3c3c3c;
    border-radius: 12px;
    padding: 20px;

    font-size: 20px;

    font-weight: bold;
    text-align: center;
}

/* --- Bottoni Primari (Salva, Crea, Avanti) --- */
QPushButton[class="PrimaryButton"] {
    background-color: #007acc;
    color: white;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
    border: none;
}
QPushButton[class="PrimaryButton"]:hover {
    background-color: #5c9cdf;
}
QPushButton[class="PrimaryButton"]:disabled {
    background-color: #333333;
    color: #777777;
}

/* --- Bottoni Secondari (Annulla, Home, ecc) --- */
QPushButton {
    background-color: #3c3c3c;
    color: #f0f0f0;
    border-radius: 6px;
    padding: 8px 16px;
    border: 1px solid #555555;
}
QPushButton:hover {
    background-color: #4a4a4a;
    border: 1px solid #777777;
}

/* --- Input e ComboBox --- */
QLineEdit, QComboBox, QTextEdit {
    background-color: #2d2d30;
    color: #f0f0f0;
    border: 1px solid #3c3c3c;
    border-radius: 4px;
    padding: 6px;
}
QLineEdit:focus, QComboBox:focus, QTextEdit:focus {
    border: 1px solid #4b8bcf; /* Bordo azzurro quando ci clicchi dentro */
}


/* --- Etichette Titolo (Riutilizzabile in varie View) --- */
QLabel[class="SectionTitle"] {
    color: #aaaaaa;
    font-size: 16px;
    font-weight: bold;
    letter-spacing: 1px;
}

/* --- Liste (QListWidget per i Progetti Recenti) --- */
QListWidget {
    background-color: #151515;
    color: #dddddd;
    font-size: 14px;
    border: 1px solid #333333;
    border-radius: 6px;
    padding: 5px;
}
QListWidget::item {
    padding: 8px;
    border-bottom: 1px solid #222222;
}
QListWidget::item:selected {
    background-color: #4b8bcf;
    color: white;
    border-radius: 4px;
}
QListWidget::item:hover:!selected {
    background-color: #222222;
    border-radius: 4px;
}

/* --- Menu Contestuale Globale --- */
QMenu {
    background-color: #333333;
    color: white;
    border: 1px solid #555555;
}
QMenu::item {
    padding: 6px 25px; /* Spazio per far respirare il testo */
}
/* Creiamo un ID specifico per i menù "pericolosi" (es. Elimina) */
QMenu#MenuElimina::item:selected {
    background-color: #b80f0a;
    color: white;
}


/* =========================================
   VISTA ETICHETTATURA (Labeling View)
   ========================================= */

/* Bottone a tendina "Etichette" */
QPushButton[class="MenuDropdownBtn"] {
    background-color: transparent;
    color: white;
    border: none;
    font-size: 13px;
    text-align: left;
    padding: 5px;
}
QPushButton[class="MenuDropdownBtn"]::menu-indicator {
    image: none; /* Nasconde la freccetta brutta di default */
}
QPushButton[class="MenuDropdownBtn"]:hover {
    background-color: #3c3c3c;
    border-radius: 4px;
}


/* Bottoni di Navigazione (Precedente/Successivo) */
QPushButton[class="NavButton"] {
    background-color: #3c3c3c;
    color: #aaaaaa;
    border-radius: 4px;
    padding: 8px;
}
QPushButton[class="NavButton"]:hover {
    background-color: #4a4a4a;
    color: white;
}
QPushButton[class="NavButton"]:disabled {
    background-color: #1e1e1e;
    color: #444444;
    border: 1px solid #333333;
}

/* Label del contatore (es. 1 di 100) */
QLabel[class="CounterLabel"] {
    color: #aaaaaa;
    font-size: 12px;
}

/* Bottoni Etichette (Normal, Tumor, Custom) */
QPushButton[class="LabelButton"] {
    background-color: #1e1e1e; /* Scuro, non distrae dall'immagine */
    color: #aaaaaa; /* Testo spento */
    border: 2px solid #444444; /* Bordo spesso ma neutro */
    border-radius: 8px;
    padding: 12px;
    font-size: 15px;
    font-weight: bold;
}

/* Quando ci passi sopra col mouse (ma non è premuto) */
QPushButton[class="LabelButton"]:hover {
    border: 2px solid #666666;
    color: #ffffff;
    background-color: #2a2a2a;
}

/* QUANDO È SELEZIONATO (Il colore esplode e rimuove ogni ambiguità) */
QPushButton[class="LabelButton"]:checked {
    background-color: #4b8bcf; /* Azzurro primario del tuo software */
    border: 2px solid #4b8bcf; /* Il bordo diventa dello stesso colore */
    color: white; /* Testo brillante */
}

/* Area Note */
QTextEdit[class="NoteInput"] {
    background-color: #2d2d30;
    color: white;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 8px;
    /* NIENTE CORSIVO PER L'INPUT UTENTE, E' UNA PESSIMA UX! */
    font-style: normal;
}
QTextEdit[class="NoteInput"]:focus {
    border: 1px solid #4b8bcf;
}

/* =========================================
   VISTA DASHBOARD
   ========================================= */

/* Sfondo delle Card */
QFrame[class="Card"] {
    background-color: #252526;
    border-radius: 12px;
    border: 1px solid #1e1e1e;
    border-top: 1px solid #3c3c3c;
}

/* Titolo principale del Progetto */
QLabel[class="HeaderTitle"] {
    color: white;
    font-size: 26px;
    font-weight: bold;
}

/* Etichette Informative (Chiave - Valore) */
QLabel[class="InfoLabel"] {
    color: #999999;
    font-size: 13px;
    letter-spacing: 0.5px;
}

QLabel[class="InfoValue"] {
    color: #ffffff;
    font-size: 13px;
    font-weight: bold;
    background-color: #333333; /* Crea il riquadro */
    padding: 4px 12px; /* Dà respiro al testo */
    border-radius: 6px; /* Arrotonda il riquadro */
    border: 1px solid #444444;
}

/* Bottone Indietro (Trasparente con bordo) */
QPushButton#BtnBack {
    background-color: transparent;
    color: #aaaaaa;
    border: 1px solid #555555;
    border-radius: 6px;
    padding: 8px 15px;
    font-size: 13px;
}
QPushButton#BtnBack:hover {
    background-color: #3c3c3c;
    color: white;
}

/* Barra di Progresso */
QProgressBar {
    background-color: #333333;
    color: white;
    border: none;
    border-radius: 6px;
    min-height: 18px; /* Un po' più alta per contenere il testo percentuale */
    text-align: center; /* Centra la percentuale */
}
QProgressBar::chunk {
    background-color: #4b8bcf;
    border-radius: 6px;
}

/* =========================================
   VISTA IMPOSTAZIONI SLIDE & ROI
   ========================================= */

/* Label Istruzioni e Highlight */
QLabel[class="InstructionLabel"] { color: #aaaaaa; font-size: 11px; }
QLabel[class="HighlightLabel"] { color: #4b8bcf; font-weight: bold; }

/* Icona Info (La "i" blu tonda) */
QLabel[class="InfoBadge"] {
    background-color: #4b8bcf;
    color: white;
    border-radius: 8px;
    font-family: "Times New Roman", serif;
    font-weight: bold;
    font-size: 11px;
}
QLabel[class="InfoBadge"]:hover { background-color: #5c9cdf; }

/* Bottoncini piccoli per strumenti (es. Cancella ROI) */
QPushButton[class="SmallToolButton"] {
    background-color: #333333;
    color: white;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 11px;
}
QPushButton[class="SmallToolButton"]:hover { background-color: #4a4a4a; }

/* =========================================
            QMESSAGEBOX
   ========================================= */

QMessageBox QPushButton {
    min-width: 80px;
    height: 32px; /* LA MAGIA: Forza la stessa altezza per tutti i bottoni */
    margin: 0px;
    padding: 0px 15px; /* Riduciamo il padding verticale rispetto agli altri bottoni */
    outline: none; /* Uccide l'anello di focus invisibile di Windows */
}

/* Stile per il bottone preselezionato (Default) */
QMessageBox QPushButton:default {
    border: 2px solid #4b8bcf;
    background-color: #2d2d30;
}